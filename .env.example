# OneFirewall Classifier Configuration
# Copy this file to .env and fill in your actual values

# OneFirewall API Key (required for real-time threat intelligence)
# Get your API key from: https://app.onefirewall.com
ONEFIREWALL_API_KEY=your-api-key-here

# OneFirewall API Base URL (optional, defaults to https://app.onefirewall.com)
# ONEFIREWALL_BASE_URL=https://app.onefirewall.com

# Server Configuration (optional)
# PORT=8080
# LOG_LEVEL=info

# Database Paths (optional)
# IPDB_PATH=data/ip2asn-v4.tsv
# MALICIOUS_IPS_PATH=data/malicious-ips.json
